[Unit]
Description=tu4ka air quality service
# Слушающий сокет держит systemd, не приложение: тогда `systemctl restart
# tu4ka.service` не закрывает порт, соединения ждут в очереди ядра и достаются
# новому процессу. Деплой перестаёт ронять запросы. Рестартовать на выкладке
# нужно только .service; рестарт .socket пересоздаёт дескриптор и дырку вернёт.
Requires=tu4ka.socket
After=tu4ka.socket network-online.target
Wants=network-online.target

[Service]
User=tu4ka
Group=tu4ka
EnvironmentFile=/etc/tu4ka/env
WorkingDirectory=/opt/tu4ka/app
# Миграции схемы — отдельным процессом до старта uvicorn, а не из lifespan:
# перестроение таблицы не должно идти под живым трафиком. Упадёт — сервис не
# поднимется, и это правильно: работать по отставшей схеме хуже.
ExecStartPre=/opt/tu4ka/venv/bin/python -m server.migrate
# --fd 3 вместо --host/--port: дескриптор приходит от systemd (LISTEN_FDS),
# первый переданный сокет — всегда 3.
ExecStart=/opt/tu4ka/venv/bin/uvicorn server.main:app --app-dir /opt/tu4ka/app --fd 3 --workers 1
Restart=always
RestartSec=3
# Порт больше не привилегированный (8000 за nginx), права на bind не нужны.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tu4ka
PrivateTmp=true

[Install]
WantedBy=multi-user.target
