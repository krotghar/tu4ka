[Unit]
Description=tu4ka: ежедневный бэкап базы

[Timer]
# 03:20 UTC — промежуток между чужими таймерами системы (motd-news 03:54,
# certbot 06:59), чтобы не толкаться за диск.
OnCalendar=*-*-* 03:20:00
RandomizedDelaySec=15m
# Сервер могли выключить на ночь: Persistent догоняет пропущенный прогон
# при следующем старте, иначе в истории бэкапов появлялись бы дыры.
Persistent=true

[Install]
WantedBy=timers.target
